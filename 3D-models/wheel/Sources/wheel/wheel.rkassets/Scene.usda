#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1.0
    upAxis = "Y"
    doc = "Mercedes F1 Steering Wheel (2021) - Converted via Blender"
)

def Xform "Root"
{
    def "MercedesF1SteeringWheel" (
        prepend references = @./MercedesF1Wheel.usdz@
    )
    {
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
