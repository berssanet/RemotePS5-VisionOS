//
//  SpatialDisplacement.metal
//  VisionRemotePS5
//
//  Metal shader for spatial depth displacement.
//  Reads the AI-generated depth texture and physically pushes vertices along their normals.
//
//  DepthAnything convention: White (1.0) = Near, Black (0.0) = Far
//

#include <metal_stdlib>
#include <RealityKit/RealityKit.h>

using namespace metal;

// MARK: - Geometry Modifier for RealityKit CustomMaterial

/// Spatial displacement geometry modifier.
/// Samples the depth texture and offsets vertices along their normals.
[[visible]]
void spatialDisplacement(realitykit::geometry_parameters params)
{
    // Access the texture bound to the 'custom' slot of the Material
    texture2d<float> depthMap = params.textures().custom();
    
    // Fail-safe for the first few frames before depth is available
    if (is_null_texture(depthMap)) return;
    
    constexpr sampler linearSampler(address::clamp_to_edge, filter::linear);
    float2 uv = params.geometry().uv0();
    
    // Sample depth (Red channel)
    // DepthAnything: White (1.0) = Near, Black (0.0) = Far
    float depthVal = depthMap.sample(linearSampler, uv).r;
    
    // Intensity: Maximum displacement depth (15cm default)
    // Adjust this value to control the 3D "pop" effect
    float intensity = 0.15;
    
    // Displace vertex along its normal direction
    float3 offset = params.geometry().normal() * (depthVal * intensity);
    
    params.geometry().set_model_position_offset(offset);
}

// MARK: - Surface Shader for Unlit Video Display

/// Simple unlit surface shader that samples the video texture.
/// Used in conjunction with spatialDisplacement for the spatial 3D effect.
[[visible]]
void spatialSurface(realitykit::surface_parameters params)
{
    // Sample the base color texture (video frame)
    texture2d<float> videoTexture = params.textures().base_color();
    
    if (is_null_texture(videoTexture)) {
        // Fallback to black if no texture
        params.surface().set_emissive_color(half3(0.0));
        return;
    }
    
    constexpr sampler linearSampler(address::clamp_to_edge, filter::linear);
    float2 uv = params.surface().uv0();
    
    // Sample video and output as emissive (unlit)
    half3 color = half3(videoTexture.sample(linearSampler, uv).rgb);
    params.surface().set_emissive_color(color);
}

// MARK: - Combined Geometry + Surface Modifier

/// Alternative: Combined modifier that handles both displacement and surface color.
/// Use this if you want a single shader entry point.
[[visible]]
void spatialDisplacementWithDepthVisualization(realitykit::geometry_parameters params)
{
    texture2d<float> depthMap = params.textures().custom();
    
    if (is_null_texture(depthMap)) return;
    
    constexpr sampler linearSampler(address::clamp_to_edge, filter::linear);
    float2 uv = params.geometry().uv0();
    
    float depthVal = depthMap.sample(linearSampler, uv).r;
    
    // Variable intensity based on configurable depth scale
    // Could be passed via material properties in future
    float intensity = 0.15;
    
    float3 offset = params.geometry().normal() * (depthVal * intensity);
    params.geometry().set_model_position_offset(offset);
}
